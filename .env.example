APP_NAME=Fish Monitor
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://fish:fish@postgres:5432/fish_monitor
AUTO_CREATE_TABLES=true

UPLOAD_ROOT=/data/uploads
JOB_ROOT=/data/jobs
OUTPUT_ROOT=/data/outputs
MAX_UPLOAD_BYTES=5368709120
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.avi,.mkv

VIAME_MOCK=true
DEPLOYMENT_MODE=auto
VIAME_ROOT=/opt/noaa/viame
VIAME_SETUP_SCRIPT=/opt/noaa/viame/setup_viame.sh
VIAME_TRACKER_PIPELINE=/app/app/viame_pipelines/tracker_fish_no_motion.pipe
VIAME_DETECTOR_PIPELINE=/opt/noaa/viame/configs/pipelines/detector_default_fish_no_motion.pipe
VIAME_TIMEOUT_SECONDS=14400
VIAME_SAMPLE_CSV=app/fixtures/sample_viame_output.csv
VIAME_DOWNSAMPLE_FPS=10
VIAME_FRAME_NUMBER_OFFSET=0
VIAME_DETECTOR_SCORE_THRESHOLD=0.10
VIAME_TRACKER_HIGH_THRESHOLD=0.45
VIAME_TRACKER_LOW_THRESHOLD=0.10
VIAME_TRACKER_NEW_TRACK_THRESHOLD=0.50
VIAME_TRACKER_BUFFER_FRAMES=30
VIAME_RUN_COMMAND=source "$VIAME_SETUP_SCRIPT" && kwiver runner -I "$VIAME_ROOT/configs/pipelines" "$VIAME_PIPELINE" -s "input:video_filename=$VIAME_INPUT_VIDEO" -s "input:video_reader:type=vidl_ffmpeg" -s "downsampler:target_frame_rate=$VIAME_DOWNSAMPLE_FPS" -s "downsampler:renumber_frames=false" -s "detector:detector:onnx:score_thresh=$VIAME_DETECTOR_SCORE_THRESHOLD" -s "tracker:track_objects:bytetrack:high_thresh=$VIAME_TRACKER_HIGH_THRESHOLD" -s "tracker:track_objects:bytetrack:low_thresh=$VIAME_TRACKER_LOW_THRESHOLD" -s "tracker:track_objects:bytetrack:new_track_thresh=$VIAME_TRACKER_NEW_TRACK_THRESHOLD" -s "tracker:track_objects:bytetrack:track_buffer=$VIAME_TRACKER_BUFFER_FRAMES" -s "track_writer:file_name=$VIAME_OUTPUT_CSV"

MIN_FISH_CONFIDENCE=0.60
CLIP_PADDING_SECONDS=0.6
CLIP_ZOOM_MARGIN=2.2
CLIP_MIN_CROP_PIXELS=128
CLIP_OUTPUT_SHORT_SIDE=260
MODEL_NAME=viame-default-fish
MODEL_VERSION=
VIAME_VERSION=

LIVE_MONITOR_ENABLED=false
# Selectable cameras. Keys must match ^[a-z0-9-]{1,64}$ and are the only thing the API
# accepts; URLs stay server-side. Trim or retarget the list with a JSON array, e.g.
# LIVE_SOURCE_REGISTRY=[{"key":"coral-city","label":"Coral City Camera","location":"Miami, Florida","url":"https://www.coralcitycamera.com/"}]
# Leave it commented out or set to [] to keep the four cameras that ship in code.
LIVE_DEFAULT_SOURCE_KEY=coral-city
# Overrides the URL of the coral-city registry entry only.
CORAL_CITY_URL=https://www.coralcitycamera.com/
LIVE_LOST_TRACK_SECONDS=10
LIVE_SEGMENT_SECONDS=2
LIVE_FPS=4
# Preserve detail for detection; smaller camera feeds are never upscaled.
LIVE_CAPTURE_WIDTH=1920
LIVE_CAPTURE_HEIGHT=1080
# The annotated view only feeds the dashboard, which refreshes it every two
# seconds. Publishing a full-size frame four times a second cost more than the
# tracking did, so it is published smaller and less often; detection is unaffected.
LIVE_SNAPSHOT_FPS=2
LIVE_SNAPSHOT_MAX_WIDTH=1280
LIVE_ACTIVITY_WINDOW_SECONDS=60
LIVE_RETRY_SECONDS=3
LIVE_MAX_RETRY_SECONDS=30
LIVE_MAX_RETRIES=10
LIVE_READ_TIMEOUT_SECONDS=20
LIVE_DETECTOR_TIMEOUT_SECONDS=60
LIVE_WORKER_STALE_SECONDS=120
LIVE_MAX_PENDING_SEGMENTS=3
# Per-frame crop spool. Keep on fast local disk, never on a slow bound volume.
# LIVE_SCRATCH_ROOT=/tmp/fish-live-scratch

WORKER_POLL_SECONDS=3
WORKER_HEARTBEAT_SECONDS=5
WORKER_STALE_AFTER_SECONDS=30
JOB_STALE_AFTER_SECONDS=120
# Fishial credentials come from Fishial; each identified fish uses frames_per_fish image calls.
FISHIAL_ENABLED=false
# FISHIAL_API_BASE_URL=https://api-recognition.fishial.ai/v2
# FISHIAL_CLIENT_ID=
# FISHIAL_CLIENT_SECRET=
# FISHIAL_REQUEST_TIMEOUT_SECONDS=30
# FISHIAL_DEFAULT_FRAMES_PER_FISH=5
# FISHIAL_MAX_FISH_PER_SESSION=20
# Frame FLOORS, not selection criteria: they exclude unusable crops only. Selection
# is the per-track ranking. Measured over 5,239 detections on the two reference
# cameras, 0.50/40 rejects 24.0% (Coral City) and 27.0% (SmartBay 3) of frames,
# almost all of it fish crossing the frame edge. The previous 0.70/96 pair sat above
# the 90th percentile of both measurements and rejected 96.8%/85.9%.
# FISHIAL_MIN_FRAME_CONFIDENCE=0.50
# FISHIAL_MIN_CROP_PIXELS=40
# FISHIAL_EDGE_MARGIN_PIXELS=4
# FISHIAL_CROP_MARGIN=1.15
# FISHIAL_BLUR_MIN_VARIANCE=0
# Diversity rule: at most one retained frame per separation window, so votes stay
# independent rather than being cast by near-duplicate frames of one moment.
# FISHIAL_MIN_FRAME_SEPARATION_SECONDS=0.6
# FISHIAL_MIN_FRAMES_TO_VOTE=3
# FISHIAL_MIN_VOTES=3
# FISHIAL_VOTE_RATIO=0.6
# FISHIAL_MIN_SPECIES_SCORE=0.5
# FISHIAL_MIN_FRAME_MARGIN=0
# FISHIAL_MAX_API_RETRIES=2

# --- Unpaid candidate pool. Staging is local and free; only API calls cost. ---
# How many tracks may hold staged crops at once. 0 = auto, max(3 x fish_target,
# fish_target + 8), fixed at session start so a restart cannot resize it.
# FISHIAL_CANDIDATE_POOL_SIZE=0
# Retained frames per candidate. 0 = auto, frames_per_fish + 2, so the selector has
# spare frames to rank and the stop rules have room to skip weak ones.
# FISHIAL_MAX_STAGED_FRAMES_PER_CANDIDATE=0
# Ceiling on the session's staged crops on disk; weakest candidates are evicted first.
# FISHIAL_MAX_STAGED_BYTES=536870912

# --- Selection: pay for the best fish, not the first fish. ---
# Minimum track quality worth paying for. 0.0 = admit everything, which is what
# ships: the blend's pixel terms are not yet calibrated against stored data. Use
# scripts/fishial_replay.py --dry-run to calibrate before raising it.
# FISHIAL_QUALITY_FLOOR=0.0
# FISHIAL_QUALITY_WEIGHTS={"short_side":3.0,"sharpness":2.0,"confidence":1.0,"contrast":1.5,"colorfulness":1.0,"frames":1.5}
# Slots held back so a fish arriving late in the session can still win one. Released
# after FISHIAL_RESERVE_AFTER_SECONDS, and always released by finish().
# FISHIAL_LATE_RESERVE_FISH=2
# FISHIAL_RESERVE_AFTER_SECONDS=180

# --- Early stopping. Consecutive empty responses end a track. 0 disables. ---
# FISHIAL_MAX_EMPTY_RESPONSES=2

# --- Multi-object responses resolve by IoU against the stored target box. ---
# FISHIAL_OBJECT_MATCH_MIN_IOU=0.5
# FISHIAL_OBJECT_MATCH_MIN_MARGIN=0.2

# --- Operator-requested identification of ONE chosen fish, from the live view or
# --- the library. Each frame is one API call and the operator authorises each request,
# --- so the ceiling only bounds a slip of the finger. A fish seen for fewer separate
# --- moments than the frames requested is sent fewer frames, never duplicates.
# FISHIAL_REQUEST_MAX_FRAMES=12
# FISHIAL_REQUEST_DEFAULT_FRAMES=5
# How long a claimed request may hold a fish before another may take it over. Only
# reached when the process running the request died mid-flight.
# FISHIAL_REQUEST_STALE_SECONDS=900

# A request is deliberately MORE permissive than the automatic pass: it is one
# operator pointing at one fish and authorising that spend, so floors calibrated to
# protect an unattended budget only return "no answer" about a fish they can see.
# Each of these overrides its unprefixed counterpart, for requests only.
# FISHIAL_REQUEST_MIN_FRAME_CONFIDENCE=0.0
# FISHIAL_REQUEST_MIN_CROP_PIXELS=24
# FISHIAL_REQUEST_EDGE_MARGIN_PIXELS=0
# FISHIAL_REQUEST_MIN_VOTES=2
# FISHIAL_REQUEST_MIN_FRAMES_TO_VOTE=1
# FISHIAL_REQUEST_VOTE_RATIO=0.5
# FISHIAL_REQUEST_MIN_SPECIES_SCORE=0.35
# 0 disables the declining-classifier stop: the operator asked for these frames.
# FISHIAL_REQUEST_MAX_EMPTY_RESPONSES=0
# Requests FLAG an implausible name instead of discarding it, so the operator can
# judge it. Set true to make requests drop such names the way the automatic pass does.
# FISHIAL_REQUEST_REGION_FILTER_ENABLED=false

# --- Regional plausibility. A camera with no configured region filters nothing. ---
# FISHIAL_REGION_FILTER_ENABLED=true

# --- Underwater preprocessing of SELECTED Fishial crops only. SHIPS OFF: there is no
# --- evidence yet that it helps, and it can only be evaluated with stored crops.
# none | white_balance | clahe | both | funie_gan
# FISHIAL_PREPROCESS=none
# Optional FUnIE-GAN: explicit offline artifact, mounted read-only in the GPU live worker.
# Download: python scripts/funie_model.py --output data/models/funie/funie_generator.pth
# FISHIAL_FUNIE_MODEL_PATH=/models/funie_generator.pth
# FISHIAL_FUNIE_MODEL_SHA256=e4fcb50e03868f1683c244b1c125def30df335ec43d9bb001b8700c03b8f2bd6
# auto | cpu | cuda; auto uses CUDA when available. Quality range 1..100.
# FISHIAL_FUNIE_DEVICE=auto
# FISHIAL_FUNIE_JPEG_QUALITY=95
# FISHIAL_CLAHE_CLIP=2.0
# Classical modes only: upscale to this short side. none is byte-identical;
# funie_gan follows its own fixed 256x256 contract. 0 disables. Never downscales.
# FISHIAL_UPSCALE_SHORT_SIDE=0
# Keeps staged crops on the output volume past the scratch wipe so preprocessing can
# be A/B-ed offline. This RETAINS FISH IMAGERY ON DISK; off by default.
# FISHIAL_KEEP_STAGED_CROPS=false

# --- Track thumbnails: one preview crop per fish, shown in the track table.
# How much wider than the detection box to crop. Compared side by side on Coral
# City footage: 1.9 left the fish too small to name at table size, 1.45 fills it.
# THUMBNAIL_ZOOM_MARGIN=1.45
# THUMBNAIL_MIN_CROP_PIXELS=64

# --- Species reference photos: a stock portrait beside each identified name, so an
# --- operator can check the classifier by eye. Never the detected fish.
# One lookup per species name, ever, cached to SPECIES_REFERENCE_ROOT with a sidecar
# naming the photographer, the licence and the source. Set false for no outbound network;
# either way, hand-placed <slug>.jpg files in the root are used as-is.
# SPECIES_REFERENCE_ENABLED=true
# SPECIES_REFERENCE_ROOT=data/species-reference
# SPECIES_REFERENCE_API_BASE_URL=https://api.inaturalist.org/v1
# Only openly licensed photos are cached and re-served. The no-derivatives licences are
# included because the photo is shown whole, beside its credit, and is never altered.
# SPECIES_REFERENCE_ALLOWED_LICENCES=cc0,pd,cc-by,cc-by-sa,cc-by-nd,cc-by-nc,cc-by-nc-sa,cc-by-nc-nd
# New names one request may fetch; the rest are reported unknown and picked up next time.
# SPECIES_REFERENCE_MAX_LOOKUPS_PER_REQUEST=8
# SPECIES_REFERENCE_RETRY_AFTER_SECONDS=86400
# SPECIES_REFERENCE_MAX_BYTES=2097152
# SPECIES_REFERENCE_TIMEOUT_SECONDS=10
