APP_NAME=Fish Monitor
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://fish:fish@postgres:5432/fish_monitor
AUTO_CREATE_TABLES=true

UPLOAD_ROOT=/data/uploads
JOB_ROOT=/data/jobs
OUTPUT_ROOT=/data/outputs
MAX_UPLOAD_BYTES=5368709120
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.avi,.mkv

VIAME_MOCK=true
DEPLOYMENT_MODE=auto
VIAME_ROOT=/opt/noaa/viame
VIAME_SETUP_SCRIPT=/opt/noaa/viame/setup_viame.sh
VIAME_TRACKER_PIPELINE=/app/app/viame_pipelines/tracker_fish_no_motion.pipe
VIAME_DETECTOR_PIPELINE=/opt/noaa/viame/configs/pipelines/detector_default_fish_no_motion.pipe
VIAME_TIMEOUT_SECONDS=14400
VIAME_SAMPLE_CSV=app/fixtures/sample_viame_output.csv
VIAME_DOWNSAMPLE_FPS=10
VIAME_FRAME_NUMBER_OFFSET=0
VIAME_DETECTOR_SCORE_THRESHOLD=0.10
VIAME_TRACKER_HIGH_THRESHOLD=0.45
VIAME_TRACKER_LOW_THRESHOLD=0.10
VIAME_TRACKER_NEW_TRACK_THRESHOLD=0.50
VIAME_TRACKER_BUFFER_FRAMES=30
VIAME_RUN_COMMAND=source "$VIAME_SETUP_SCRIPT" && kwiver runner -I "$VIAME_ROOT/configs/pipelines" "$VIAME_PIPELINE" -s "input:video_filename=$VIAME_INPUT_VIDEO" -s "input:video_reader:type=vidl_ffmpeg" -s "downsampler:target_frame_rate=$VIAME_DOWNSAMPLE_FPS" -s "downsampler:renumber_frames=false" -s "detector:detector:onnx:score_thresh=$VIAME_DETECTOR_SCORE_THRESHOLD" -s "tracker:track_objects:bytetrack:high_thresh=$VIAME_TRACKER_HIGH_THRESHOLD" -s "tracker:track_objects:bytetrack:low_thresh=$VIAME_TRACKER_LOW_THRESHOLD" -s "tracker:track_objects:bytetrack:new_track_thresh=$VIAME_TRACKER_NEW_TRACK_THRESHOLD" -s "tracker:track_objects:bytetrack:track_buffer=$VIAME_TRACKER_BUFFER_FRAMES" -s "track_writer:file_name=$VIAME_OUTPUT_CSV"

MIN_FISH_CONFIDENCE=0.60
CLIP_PADDING_SECONDS=0.6
CLIP_ZOOM_MARGIN=2.2
CLIP_MIN_CROP_PIXELS=128
CLIP_OUTPUT_SHORT_SIDE=260
MODEL_NAME=viame-default-fish
MODEL_VERSION=
VIAME_VERSION=

WORKER_POLL_SECONDS=3
WORKER_HEARTBEAT_SECONDS=5
WORKER_STALE_AFTER_SECONDS=30
JOB_STALE_AFTER_SECONDS=120
