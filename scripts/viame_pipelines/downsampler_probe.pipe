# =============================================================================
# Title: Downsampler probe (offline experiment)
#
# Description: Records exactly which image-list entries VIAME's production
# downsampler passes. The probe CSV holds one placeholder detection per entry;
# the writer (computed_detections.csv) keeps only the passed ones. There is no
# detector, tracker or image decoding.
# =============================================================================

config _pipeline:_edge
  :capacity                                    5

config _scheduler
  :type                                        pythread_per_process

include common_no_load_input_with_downsampler.pipe

process detection_reader
  :: detected_object_input
  :file_name                                   probe.csv
  :reader:type                                 viame_csv

connect from downsampler.output_2
        to   detection_reader.image_file_name

process detection_writer
  :: detected_object_output
  :file_name                                   computed_detections.csv
  :writer:type                                 viame_csv

connect from detection_reader.detected_object_set
        to   detection_writer.detected_object_set
connect from downsampler.output_2
        to   detection_writer.image_file_name
connect from downsampler.timestamp
        to   detection_writer.timestamp

# -- end of file --
