# The dashboard is a static bundle built here and served by FastAPI. There is
# still no Node.js at runtime; this stage exists only to produce frontend/dist.
FROM node:22-alpine AS frontend

WORKDIR /build

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build


FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends bash ffmpeg libglib2.0-0 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md LICENSE_NOTES.md alembic.ini ./
COPY app ./app
COPY scripts ./scripts
COPY --from=frontend /build/dist ./frontend/dist

RUN pip install --no-cache-dir ".[annotate]"

CMD ["sh", "-c", "alembic upgrade head && exec uvicorn app.main:app --host 0.0.0.0 --port 8000"]
